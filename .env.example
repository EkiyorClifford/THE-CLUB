# Optional, and only on a server. Never put the service-role key in client code.
# This phase uses the publishable key. Do not add SUPABASE_SERVICE_ROLE_KEY here.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Playwright signs in through the form. Put these in .env.e2e, which stays untracked.
# E2E_CLUB_EMAIL=
# E2E_CLUB_PASSWORD=
